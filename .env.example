# Ambiente da aplicação: "development" ou "production".
# Em production o servidor escuta só em 127.0.0.1 (atrás do Caddy) e os logs saem em JSON.
APP_ENV=development

# Porta HTTP interna da aplicação.
PORT=8080

# DSN do MySQL. Em produção (Oracle MySQL HeatWave via IP privado), use tls=preferred:
#   app:senha@tcp(10.0.0.5:3306)/travelu?parseTime=true&loc=UTC&charset=utf8mb4&tls=preferred
DATABASE_DSN=app:app@tcp(127.0.0.1:3306)/travelu?parseTime=true&loc=UTC&charset=utf8mb4

# Segredo usado para assinar os access tokens JWT (HS256). Precisa ter pelo menos 32 bytes;
# o processo falha no startup se for menor. Gere um valor forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-value-of-at-least-32-bytes

# Validade do access token e do refresh token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Origens permitidas para CORS, separadas por vírgula. Use "*" para liberar todas (não
# recomendado em produção) ou deixe vazio para desabilitar CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Defina como "true" somente quando a aplicação estiver atrás do Caddy (ou outro proxy
# confiável): isso faz o rate limiter ler o IP real do cliente em X-Forwarded-For em vez
# da conexão TCP direta.
TRUST_PROXY=false

# Nível de log: debug, info, warn ou error.
LOG_LEVEL=info

# --- Opcional: ajuste fino do pool de conexões (todos têm defaults sensatos) ---
# DATABASE_MAX_OPEN_CONNS=25
# DATABASE_MAX_IDLE_CONNS=25
# DATABASE_CONN_MAX_LIFETIME=5m
